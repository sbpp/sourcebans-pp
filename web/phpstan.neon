includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    phpVersion: 80200
    bootstrapFiles:
        - includes/vendor/autoload.php
        - phpstan-bootstrap.php
    paths:
        - .
    excludePaths:
        - includes/vendor/*
        - includes/auth/openid.php
        - includes/tinymce/*
        - cache/*
        - templates_c/*
        - tests/*
        - phpstan-bootstrap.php

services:
    -
        class: Sbpp\PHPStan\SmartyTemplateRule
        arguments:
            templatesDir: %currentWorkingDirectory%/themes/default
        tags:
            - phpstan.rules.rule
